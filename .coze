[project]
sub_id = "5c5332ae"
name = "hvacr-net"
requires = ["nodejs-24"]
project_type = "web"
version = "0.0.32"
entrypoint = "index.html"

[preview]
preview_enable = "enabled"

[dev]
build = ["pnpm", "run", "build"]
run = ["pnpm", "run", "dev"]

[deploy]
build = ["bash", "scripts/build.sh"]
run = ["bash", "scripts/run.sh"]

[deploy.profile]
kind = "service"
flavor = "web"

[subprojects]
path = ["."]
